<script id="final-interactions-script">
document.addEventListener('DOMContentLoaded', function(){
  const filters = document.querySelectorAll('.solution-filter');
  const groups = document.querySelectorAll('.solutions-category[data-solution-group]');
  if(filters.length && groups.length){
    const applyFilter = (target)=>{
      filters.forEach(b=>b.classList.toggle('active', b.dataset.filter === target));
      groups.forEach(group=>group.classList.toggle('is-hidden', group.dataset.solutionGroup !== target));
    };
    applyFilter('platforms');
    filters.forEach(btn=>btn.addEventListener('click', ()=>applyFilter(btn.dataset.filter)));
  }

  document.querySelectorAll('.qitty-carousel').forEach(carousel=>{
    const track = carousel.querySelector('.qitty-track');
    const dots = carousel.querySelectorAll('.qitty-dot');
    if(!track || !dots.length) return;
    track.addEventListener('scroll', ()=>{
      const index = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
      dots.forEach((dot,i)=>dot.classList.toggle('active', i === index));
    }, {passive:true});
  });

  const input = document.getElementById('articleSearchInput');
  const articleFilters = document.querySelectorAll('.article-filter');
  const cards = document.querySelectorAll('.article-card');
  if(input && cards.length){
    let activeType = 'all';
    let noResult = document.querySelector('.no-article-result');
    if(!noResult){
      noResult = document.createElement('div');
      noResult.className = 'no-article-result';
      noResult.textContent = 'Aucun article ne correspond à cette recherche.';
      input.closest('.article-search-wrap').insertAdjacentElement('afterend', noResult);
    }
    const applyArticleFilters = ()=>{
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      cards.forEach(card=>{
        const text = (card.innerText + ' ' + (card.dataset.articleKeywords || '')).toLowerCase();
        const typeOk = activeType === 'all' || card.dataset.articleType === activeType;
        const searchOk = q.length < 1 || text.includes(q);
        const ok = typeOk && searchOk;
        card.classList.toggle('article-hidden', !ok);
        if(ok) shown++;
      });
      noResult.classList.toggle('show', shown === 0);
    };
    input.addEventListener('input', applyArticleFilters);
    articleFilters.forEach(btn=>{
      btn.addEventListener('click', ()=>{
        activeType = btn.dataset.articleFilter;
        articleFilters.forEach(b=>b.classList.toggle('active', b === btn));
        applyArticleFilters();
      });
    });
    applyArticleFilters();
  }
});
</script>


