    });
  }

  function detectIntent(q){
    for(const intent of INTENTS){
      if(intent.keys.some(function(k){ return q.includes(n(k)); })) return intent.id;
    }
    return 'unknown';
  }

  function detectAudience(q){
    if(['b2b','pme','entreprise','business','organisation','professionnel','societe','société','equipe','équipe'].some(k=>q.includes(n(k)))) return 'b2b';
    if(['particulier','personnel','moi','cv','emploi','formation','quotidien'].some(k=>q.includes(n(k)))) return 'particuliers';
    return '';
  }

  function findEntity(q){
    const all = [];
    Object.keys(KNOWLEDGE.platforms).forEach(function(key){
      const e = KNOWLEDGE.platforms[key];
      all.push({type:'platform', key:key, data:e});
    });
    Object.keys(KNOWLEDGE.services).forEach(function(key){
      const e = KNOWLEDGE.services[key];
      all.push({type:'service', key:key, data:e});
    });

    let best = null;
    let bestScore = 0;
    all.forEach(function(item){
      let score = 0;
      item.data.keywords.forEach(function(k){
        if(q.includes(n(k))) score += Math.max(1, n(k).length/6);
      });
      if(score > bestScore){
        bestScore = score;
        best = item;
      }
    });
    return bestScore > 0 ? best : null;
  }

  function updateState(q, intent, entity){
    const aud = detectAudience(q);
    if(aud) state.audience = aud;
    if(intent) state.lastIntent = intent;
    if(entity) {
      state.lastEntity = entity.key;
      state.projectType = entity.type;
    }
    if(['urgent','rapidement','vite','cette semaine'].some(k=>q.includes(n(k)))) state.urgency = 'urgent';
    if(['petit budget','pas cher','moins cher','budget limite','budget limité'].some(k=>q.includes(n(k)))) state.budget = 'limité';
    const sec = activeSectionKey();
    if(state.sectionHistory[state.sectionHistory.length-1] !== sec) state.sectionHistory.push(sec);
  }

  function entityAnswer(entity){
    const e = entity.data;
    const isPlatform = entity.type === 'platform';
    const paragraphs = isPlatform ? [
      '<strong>'+escapeHtml(e.title)+'</strong> est dans la catégorie <strong>'+escapeHtml(e.category)+'</strong>. La cible principale : '+escapeHtml(e.audience)+'.',
      'Le problème traité : '+escapeHtml(e.problem)+'. La valeur ajoutée : '+escapeHtml(e.value)+'.',
      'Si votre besoin ressemble à ça, la bonne étape est de regarder la démo, puis de demander un devis avec le contexte réel : utilisateurs, données, écrans, automatisations et niveau de finition souhaité.'
    ] : [
      '<strong>'+escapeHtml(e.title)+'</strong> s’adresse surtout à '+escapeHtml(e.audience)+'.',
      'Le problème typique : '+escapeHtml(e.problem)+'. La valeur ajoutée : '+escapeHtml(e.value)+'.',
      'Pour cadrer correctement, il faut identifier les tâches actuelles, les fichiers/outils utilisés, les utilisateurs concernés et le résultat attendu.'
    ];

    const linkItems = [
      {label:'Voir la section Solutions', section:e.route || 'solutions', type:'primary'},
      {label:'Demander un devis', section:'contact', type:'quote'}
    ];
    if(isPlatform && e.demo) linkItems.splice(1,0,{label:'Ouvrir la démo', url:e.demo, type:'demo'});

    return answer(e.title, paragraphs, {
      links:linkItems,
      chips:[isPlatform ? 'Plateforme' : 'Service', e.audience.split(',')[0], 'Qitty'],
      followup:'Vous pouvez me dire votre cas concret et je vous répondrai si ce service est adapté, ou s’il vaut mieux partir sur une autre solution.'
    });
  }

  function compareAnswer(q){
    let text = [
      'La bonne comparaison dépend de ce que vous voulez piloter. Un <strong>CRM</strong> suit surtout les clients, bénéficiaires, dossiers, statuts et historiques. Un <strong>ERP</strong> va plus loin : il relie plusieurs modules comme facturation, documents, audits, opérations et tableaux de bord.',
      'Un <strong>dashboard</strong> est plutôt une couche de visualisation : il ne remplace pas forcément un CRM ou un ERP, il rend les données lisibles. Une <strong>automatisation</strong>, elle, sert à supprimer des actions manuelles entre plusieurs étapes ou outils.'
    ];
    if(q.includes('crm') && q.includes('erp')){
      text.push('Donc si vous avez seulement besoin de suivre des dossiers ou clients, CRM. Si vous devez connecter plusieurs fonctions métier, ERP.');
    } else if(q.includes('dashboard')){
      text.push('Si votre problème est surtout “je ne vois pas clairement mes chiffres”, commencez par un dashboard. Si votre problème est “mes opérations sont dispersées”, il faut plutôt CRM/ERP ou automatisation.');
    } else {
      text.push('Pour choisir, dites-moi ce que vous gérez aujourd’hui : clients, dossiers, stocks, factures, documents, planning, équipes ou reporting.');
    }
    return answer('Comparaison rapide', text, {
      links:[{label:'Voir les plateformes', section:'solutions', type:'primary'}, {label:'Voir B2B / PME', section:'b2b'}, {label:'Demander un avis projet', section:'contact', type:'quote'}],
      followup:'Donnez-moi deux options à comparer, par exemple “CRM ou ERP”, et je vous fais une réponse plus tranchée.'
    });
  }

  function pricingAnswer(){
    return answer('Prix, devis et cadrage', [
      'Le prix dépend surtout de la complexité : simple automatisation, dashboard, formulaire, CRM, ERP, application avec comptes utilisateurs, paiement, rôles, fichiers, notifications ou intégrations.',
      'La bonne méthode premium consiste à commencer par le périmètre : qui utilise l’outil, quelles données entrent, quelles actions doivent être automatisées, quels écrans sont nécessaires et quel niveau de finition est attendu.',
      'Pour une demande de devis utile, écrivez simplement le problème actuel, ce que vous voulez obtenir et les outils que vous utilisez déjà. Le message ira vers <strong>'+CONTACT_EMAIL+'</strong>.'
    ], {
      links:[{label:'Ouvrir Contact / devis', section:'contact', type:'quote'}, {label:'Voir les solutions', section:'solutions', type:'primary'}],
      chips:['Devis', 'Cadrage', 'Budget'],
      followup:'Vous pouvez me décrire votre projet en une phrase et je vous aide à formuler une demande de devis claire.'
    });
  }

  function salesAnswer(q){
    const aud = state.audience || detectAudience(q);
    let angle = aud === 'b2b'
      ? 'Comme vous parlez d’un contexte professionnel, je raisonnerais en priorité sur les processus, les utilisateurs, les données, les rôles et le retour sur investissement.'
      : aud === 'particuliers'
      ? 'Comme cela semble personnel, je raisonnerais plutôt sur l’usage concret, le gain de temps, la simplicité et l’accompagnement.'
      : 'Je vais d’abord chercher à comprendre si votre besoin est personnel, professionnel, ou les deux.';
    return answer('Cadrage de votre projet', [
      angle,
      'Pour cadrer proprement, il faut répondre à quatre questions : <strong>quel problème voulez-vous résoudre</strong>, <strong>qui utilisera la solution</strong>, <strong>quelles données ou fichiers sont concernés</strong>, et <strong>quel résultat doit être visible à la fin</strong>.',
      'Selon vos réponses, Qitty peut orienter vers une automatisation simple, un dashboard, un CRM, une plateforme métier, une app ou un accompagnement IA.'
    ], {
      links:[{label:'Voir Solutions', section:'solutions', type:'primary'}, {label:'Voir B2B / PME', section:'b2b'}, {label:'Contact / devis', section:'contact', type:'quote'}],
      chips:['Qualification projet', aud || 'À clarifier', 'Prochaine étape'],
      followup:'Répondez juste à ceci : c’est pour vous, pour une entreprise, ou pour une organisation ?'
    });
  }

  function supportAnswer(){
    return answer('Support site et démos', [
      'Si une page ou une démo ne s’ouvre pas, il y a généralement trois causes : le lien pointe vers une page qui n’existe pas encore, le navigateur bloque l’ouverture dans un nouvel onglet, ou le fichier n’a pas encore été publié sur le domaine.',
      'Les boutons de démo sont prévus pour ouvrir des pages du type <strong>qitty.space/xxx.html</strong>. Si la page n’existe pas encore côté hébergement, le bouton fonctionne techniquement mais la page affichera une erreur.',
      'Pour résoudre ça, il faut vérifier que le fichier HTML correspondant existe bien sur le serveur avec exactement le même nom.'
    ], {
      links:[{label:'Voir Solutions', section:'solutions', type:'primary'}, {label:'Contacter Qitty', section:'contact', type:'quote'}],
      chips:['Support', 'Démo', 'Publication'],
      followup:'Dites-moi quel bouton ou quelle démo pose problème, et je vous indique le nom de fichier à vérifier.'
    });
  }

  function contactAnswer(){
    return answer('Contact et demande de devis', [
      'Pour contacter Qitty, le plus efficace est d’expliquer votre besoin en langage simple : votre activité, le problème actuel, les utilisateurs concernés, les outils utilisés et le résultat attendu.',
      'Tous les emails ou demandes de devis du site doivent être orientés vers <strong>'+CONTACT_EMAIL+'</strong>.',
      'Si vous n’avez pas encore un cahier des charges, ce n’est pas bloquant : décrivez seulement le problème et Qitty peut aider à le cadrer.'
    ], {
      links:[{label:'Ouvrir la section Contact', section:'contact', type:'quote'}, {label:'Voir les solutions avant', section:'solutions', type:'primary'}],
      chips:['Contact', 'Devis', CONTACT_EMAIL],
      followup:'Vous pouvez me dicter votre idée en quelques lignes, et je vous aide à transformer ça en message de contact.'
    });
  }

  function demoAnswer(entity){
    if(entity && entity.type === 'platform' && entity.data.demo){
      return answer('Démo disponible', [
        'Pour <strong>'+escapeHtml(entity.data.title)+'</strong>, le bouton de démo doit ouvrir la page correspondante sur qitty.space.',
        'Si la page ne s’ouvre pas, il faut vérifier que le fichier HTML existe bien sur le serveur avec le même nom que le lien.'
      ], {
        links:[{label:'Ouvrir la démo', url:entity.data.demo, type:'demo'}, {label:'Voir Solutions', section:'solutions', type:'primary'}, {label:'Demander un devis', section:'contact', type:'quote'}],
        followup:'Vous pouvez aussi me demander quelle démo correspond à CRM, ERP, Easy Apply, Planning ou DOBON.'
      });
    }
    return answer('Démos Qitty', [
      'Les démos servent à montrer des exemples concrets de plateformes ou outils : CRM, ERP, Planning Management, Easy Apply, DOBON, partage de plats, Alzheimer, garde parentale et autres démonstrateurs.',
      'Chaque bouton “Consulter Démo” est prévu pour ouvrir une page indépendante sur le domaine qitty.space.'
    ], {
      links:[{label:'Voir les démos dans Solutions', section:'solutions', type:'primary'}, {label:'Demander une démo personnalisée', section:'contact', type:'quote'}],
      followup:'Dites-moi le nom de la démo que vous voulez voir, et je vous oriente vers la bonne page.'
    });
  }

  function securityAnswer(){
    return answer('Sécurité, données et RGPD', [
      'Pour un projet sérieux, il faut penser dès le départ aux données collectées, aux accès, aux rôles utilisateurs, aux exports, aux sauvegardes, aux droits de consultation et aux informations sensibles.',
      'Qitty peut aider à structurer une solution plus propre : limiter les données inutiles, clarifier les rôles, documenter les flux et éviter de mélanger des informations personnelles dans des fichiers dispersés.',
      'Le niveau exact dépend du projet : une simple automatisation Excel n’a pas les mêmes exigences qu’une plateforme avec comptes, documents, paiements ou données sensibles.'
    ], {
      links:[{label:'Voir l’approche Qitty', section:'about', type:'primary'}, {label:'Voir B2B / PME', section:'b2b'}, {label:'Discuter sécurité projet', section:'contact', type:'quote'}],
      chips:['RGPD', 'Accès', 'Données'],
      followup:'Expliquez-moi quelles données votre projet manipule, et je vous dis les points de vigilance.'
    });
  }

  function timelineAnswer(){
    return answer('Délais et livraison', [
      'Le délai dépend du périmètre. Une automatisation ciblée ou un prototype peut être rapide. Une plateforme avec comptes, rôles, données, documents, paiement ou plusieurs modules demande plus de cadrage.',
      'La logique premium est de livrer par étapes : cadrage, maquette, prototype fonctionnel, tests, corrections, puis version plus propre.',
      'Si c’est urgent, il faut réduire le périmètre initial et viser une première version utile plutôt qu’un outil complet dès le premier jour.'
    ], {
      links:[{label:'Voir Solutions', section:'solutions', type:'primary'}, {label:'Demander un délai projet', section:'contact', type:'quote'}],
      chips:['Cadrage', 'Prototype', 'Itération'],
      followup:'Dites-moi ce que vous voulez livrer en premier, et je vous aide à définir une V1 réaliste.'
    });
  }

  function maintenanceAnswer(){
    return answer('Maintenance et évolutions', [
      'Un bon outil ne s’arrête pas à la première livraison. Il faut souvent prévoir des ajustements : nouveaux champs, nouveaux rôles, corrections, exports, indicateurs, intégrations ou amélioration UX.',
      'Pour une solution professionnelle, Qitty peut penser la structure dès le départ pour éviter que l’outil devienne difficile à maintenir.',
      'Le plus important est de distinguer la V1 indispensable des évolutions futures.'
    ], {
      links:[{label:'Voir B2B / PME', section:'b2b', type:'primary'}, {label:'Contact maintenance', section:'contact', type:'quote'}],
      chips:['Maintenance', 'Évolutions', 'V1'],
      followup:'Vous pouvez me dire si votre priorité est une première version rapide ou une plateforme stable long terme.'
    });
  }

  function navigationAnswer(q){
    const map = [
      ['accueil','accueil'], ['qui sommes','about'], ['about','about'], ['particulier','particuliers'],
      ['b2b','b2b'], ['pme','b2b'], ['solution','solutions'], ['outil','solutions'],
      ['article','articles'], ['blog','articles'], ['contact','contact'], ['devis','contact']
    ];
    let target = '';
    map.forEach(function(pair){
      if(!target && q.includes(n(pair[0]))) target = pair[1];
    });
    if(target){
      return answer('Redirection utile', [
        'Oui, la section la plus pertinente est <strong>'+sectionLabel(target)+'</strong>.',
        (KNOWLEDGE.sections[target] || {}).pitch || 'Je peux vous y rediriger directement.'
      ], {
        links:[{label:'Aller à '+sectionLabel(target), section:target, type:'primary'}],
        followup:'Cliquez sur le lien pour fermer le chat et aller directement à la section.'
      });
    }
    return answer('Navigation dans le site', [
      'Je peux vous rediriger vers Accueil, Qui sommes-nous, Particuliers, B2B, Solutions, Articles ou Contact.',
      'Dites-moi simplement ce que vous cherchez : une démo, un devis, une offre pro, un accompagnement particulier ou une explication.'
    ], {
      links:[{label:'Solutions', section:'solutions', type:'primary'}, {label:'B2B / PME', section:'b2b'}, {label:'Contact', section:'contact', type:'quote'}],
      followup:'Vous pouvez écrire “emmène-moi vers contact” ou “je veux voir les plateformes”.'
    });
  }

  function genericContextAnswer(q){
    const sec = activeSectionKey();
    const secInfo = KNOWLEDGE.sections[sec] || KNOWLEDGE.sections.accueil;
    return answer('Je peux vous aider à préciser', [
      'Je comprends l’idée générale, mais je veux éviter de vous donner une réponse vague. Actuellement, vous êtes dans <strong>'+escapeHtml(secInfo.label)+'</strong>, donc je peux déjà contextualiser : '+escapeHtml(secInfo.pitch),
      'Pour vous répondre mieux, dites-moi si vous cherchez plutôt : une explication, un devis, une démo, une automatisation, un CRM/ERP, un dashboard, une formation IA, ou un accompagnement particulier.',
      'Si vous avez un projet, donnez-moi une phrase simple : “je veux créer…”, “je veux automatiser…”, “je veux gérer…”.'
    ], {
      links:[{label:'Voir Solutions', section:'solutions', type:'primary'}, {label:'Contact / devis', section:'contact', type:'quote'}],
      chips:['Clarification', 'Support', 'Sales'],
      followup:'Posez une question plus précise et je vous répondrai avec une orientation concrète.'
    });
  }

  function greetingAnswer(){
    return answer('Bonjour, comment je peux vous aider ?', [
      'Vous pouvez me parler naturellement. Je peux agir comme assistant commercial, support client et guide du site : expliquer les services, comparer les solutions, vous aider à cadrer un projet ou vous rediriger vers la bonne section.',
      'Je connais les sections du site, les services, les plateformes, les démos, le contact, les questions de prix, de délais, de support et de choix entre solutions.'
    ], {
      links:[],
      chips:['Support', 'Sales', 'Guide du site', 'Conseil projet'],
      context:false,
      followup:'Essayez par exemple : “je veux automatiser mon activité”, “CRM ou ERP ?”, “combien ça coûte ?”, “je veux voir une démo”, ou “ça va ?”.'
    });
  }

  function smallTalk(intent){
    if(intent === 'howareyou'){
      return answer('Ça va très bien, merci.', [
        'Je suis prêt à vous aider. Vous pouvez me poser une question banale, me parler d’un projet ou me demander quelle solution Qitty choisir.',
        'Même si votre besoin est flou, je peux vous aider à le structurer étape par étape.'
      ], {
        links:[{label:'Voir les solutions', section:'solutions', type:'primary'}, {label:'Contact / devis', section:'contact', type:'quote'}],
        context:false,
        followup:'Dites-moi simplement ce que vous voulez faire.'
      });
    }
    if(intent === 'thanks'){
      return answer('Avec plaisir.', [
        'Je reste disponible pour préciser, comparer ou vous orienter. Si vous voulez, vous pouvez me donner votre cas concret et je vous propose une prochaine étape.'
      ], {
        links:[{label:'Voir Solutions', section:'solutions', type:'primary'}, {label:'Contact', section:'contact', type:'quote'}],
        context:false,
        followup:'Vous pouvez continuer avec une question comme “quel service me correspond ?”.'
      });
    }
    if(intent === 'bye'){
      return answer('À bientôt.', [
        'Merci pour votre passage. Quand vous voudrez avancer, vous pourrez revenir avec une idée, une question ou une demande de devis.'
      ], {links:[{label:'Contact', section:'contact', type:'quote'}], context:false, followup:'Bonne continuation.'});
    }
    if(intent === 'identity'){
      return answer('Je suis l’assistant Qitty Premium V2.', [
        'Mon rôle est de vous aider dans le site comme un assistant de vente, support client et conseiller projet. Je peux expliquer les services, qualifier un besoin, comparer CRM/ERP/dashboard, ouvrir une démo ou vous rediriger.',
        'Je ne suis pas connecté à une IA externe dans cette version : je fonctionne avec une base de connaissance intégrée au code du site, enrichie pour couvrir un maximum de cas.'
      ], {
        links:[{label:'Voir Qui sommes-nous', section:'about', type:'primary'}, {label:'Voir Solutions', section:'solutions'}, {label:'Contact', section:'contact', type:'quote'}],
        context:false,
        followup:'Demandez-moi un sujet précis et je vous répondrai avec le contexte Qitty.'
      });
    }
    return null;
  }

  function mainReply(message){
    const q = n(message);
    const intent = detectIntent(q);
    const entity = findEntity(q);
    updateState(q, intent, entity);

    if(intent === 'time') return currentTimeAnswer();
    if(['greeting','howareyou','thanks','bye','identity'].includes(intent)) return smallTalk(intent) || greetingAnswer();
    if(entity && !['compare','demo'].includes(intent)) return entityAnswer(entity);
    if(intent === 'demo') return demoAnswer(entity);
    if(intent === 'compare') return compareAnswer(q);
    if(intent === 'pricing') return pricingAnswer();
    if(intent === 'contact') return contactAnswer();
    if(intent === 'sales') return salesAnswer(q);
    if(intent === 'support') return supportAnswer();
    if(intent === 'security') return securityAnswer();
    if(intent === 'timeline') return timelineAnswer();
    if(intent === 'maintenance') return maintenanceAnswer();
    if(intent === 'navigation') return navigationAnswer(q);
    if(intent === 'help') return salesAnswer(q);

    if(q.length < 3){
      return answer('Je vous écoute', [
        'Écrivez une phrase un peu plus complète, même simple. Par exemple : “je veux automatiser mes emails”, “je cherche un CRM”, “je veux un devis” ou “explique-moi les plateformes”.'
      ], {links:[{label:'Voir Solutions', section:'solutions', type:'primary'}], context:false});
    }

    return genericContextAnswer(q);
  }

  function submitMessage(){
    const msg = chatInput ? chatInput.value.trim() : '';
    if(!msg) return;
    if(chatInput) chatInput.value = '';
    state.turns += 1;
    addUser(msg);
    const typing = (typeof showTyping === 'function') ? showTyping() : null;
    setTimeout(function(){
      if(typing) typing.remove();
      addBot(mainReply(msg));
    }, 430);
  }

  function bindLinks(){
    document.querySelectorAll('.qitty-v2-link').forEach(function(btn){
      if(btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', function(e){
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        const url = btn.getAttribute('data-qitty-url');
        const section = btn.getAttribute('data-qitty-route');
        if(url){
          window.open(url, '_blank', 'noopener');
          return false;
        }
        route(section);
        return false;
      }, true);
    });
  }

  if(chatForm){
    chatForm.addEventListener('submit', function(e){
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      submitMessage();
      return false;
    }, true);
  }

  if(chatInput){
    chatInput.addEventListener('keydown', function(e){
      if(e.key === 'Enter'){
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        submitMessage();
        return false;
      }
    }, true);
  }

  if(chatClose){
    chatClose.addEventListener('click', function(e){
      e.preventDefault();
      e.stopPropagation();
      closeChat();
      return false;
    }, true);
  }

  if(chatModal){
    chatModal.addEventListener('click', function(e){
      if(e.target === chatModal) closeChat();
    });
  }

  if(chatReset){
    chatReset.addEventListener('click', function(e){
      e.preventDefault();
      try{ localStorage.removeItem('qittyChatHistory'); }catch(err){}
      if(stage) stage.innerHTML = '';
      state.turns = 0;
      state.lastIntent = '';
      state.lastEntity = '';
      addBot(greetingAnswer());
      return false;
    }, true);
  }

  const openers = [document.getElementById('floatingChatbotBtn'), document.querySelector('.header-video')].filter(Boolean);
  openers.forEach(function(btn){
    btn.addEventListener('click', function(){
      openChat();
      setTimeout(function(){
        if(stage && !stage.dataset.qittyV103Welcome){
          stage.dataset.qittyV103Welcome = '1';
          addBot(greetingAnswer());
        }
      }, 260);
    }, true);
  });

  document.addEventListener('click', function(e){
    const btn = e.target.closest('.qitty-v2-link');
    if(!btn) return;
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation();
    const url = btn.getAttribute('data-qitty-url');
    if(url){
      window.open(url, '_blank', 'noopener');
      return false;
    }
    route(btn.getAttribute('data-qitty-route'));
    return false;
  }, true);

  bindLinks();
});
</script>

</body>
</html>
