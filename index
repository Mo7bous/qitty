<script id="qitty-v63-exact-service-buttons-fix-script">
document.addEventListener('DOMContentLoaded', function(){
  const serviceNames = [
    'Automatisation de workflows',
    'Dashboarding',
    'Formation IA',
    'Excel VBA'
  ];

  document.querySelectorAll('[data-section="solutions"] article').forEach(function(card){
    const txt = (card.textContent || '').toLowerCase();
    const isTarget = serviceNames.some(function(name){ return txt.includes(name.toLowerCase()); });
    if(!isTarget) return;

    card.classList.add('qitty-target-service-card');

    let actions = card.querySelector('.service-actions') || card.querySelector('.card-actions');
    if(!actions){
      actions = document.createElement('div');
      actions.className = 'service-actions';
      const buttons = Array.from(card.querySelectorAll('a.btn, button.btn, .technical-spec-btn'));
      buttons.forEach(function(btn){ actions.appendChild(btn); });
      card.appendChild(actions);
    }

    actions.style.display = 'flex';
    actions.style.flexDirection = 'column';
    actions.style.alignItems = 'center';
    actions.style.justifyContent = 'center';
    actions.style.gap = '10px';
    actions.style.width = '100%';

    const buttons = Array.from(actions.querySelectorAll('a, button, .btn'));
    buttons.forEach(function(btn, index){
      btn.style.width = window.innerWidth <= 760 ? '82vw' : '300px';
      btn.style.maxWidth = window.innerWidth <= 760 ? '330px' : '300px';
      btn.style.minWidth = window.innerWidth <= 760 ? '0' : '300px';
      btn.style.marginLeft = 'auto';
      btn.style.marginRight = 'auto';
      btn.style.display = 'flex';
      btn.style.justifyContent = 'center';
      btn.style.alignItems = 'center';
      btn.style.textAlign = 'center';
      btn.style.borderRadius = '999px';

      if(index === 0){
        btn.style.background = 'linear-gradient(90deg,#071b55,#123c98)';
        btn.style.color = '#fff';
      } else {
        btn.style.background = 'linear-gradient(90deg,#6f9bff,#9bb8ff)';
        btn.style.color = '#fff';
      }
    });
  });
});
</script>


