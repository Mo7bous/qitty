    const heure = now.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
    return answer('Heure et date', [
      'Nous sommes '+jour+' '+date+'. Il est environ '+heure+'.',
      'Je peux aussi vous aider sur le site : expliquer une offre, trouver une démo, préparer un devis ou vous orienter vers la bonne section.'
