  function openContactSection(){
    var target = 'contact';
    document.querySelectorAll('.page-section').forEach(function(section){
      section.classList.toggle('active', section.dataset.section === target);
    });
    document.querySelectorAll('[data-target], [data-section-target]').forEach(function(btn){
      var btnTarget = btn.getAttribute('data-target') || btn.getAttribute('data-section-target');
      if(btnTarget) btn.classList.toggle('active', btnTarget === target);
    });
    var subject = document.querySelector('[data-contact-subject], #contact-subject, input[name="subject"], select[name="subject"], textarea[name="subject"]');
    if(subject && 'value' in subject){
      subject.value = 'Demande de devis personnalisé';
      subject.dispatchEvent(new Event('input', {bubbles:true}));
      subject.dispatchEvent(new Event('change', {bubbles:true}));
    }
    window.scrollTo({top:0, behavior:'smooth'});
  }

  document.querySelectorAll('.solutions-contact-btn').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault();
      openContactSection();
    });
  });

  var modal = document.getElementById('techSpecModal');
  var title = document.getElementById('techSpecTitle');
  var intro = document.getElementById('techSpecIntro');
  var sectionsWrap = document.getElementById('techSpecSections');

  function openTechModal(key){
    var data = techSpecs[key];
    if(!data || !modal || !title || !intro || !sectionsWrap) return;

    title.textContent = data.title || 'Spécificités techniques';
    intro.textContent = data.intro || '';
    sectionsWrap.innerHTML = '';

    (data.sections || []).forEach(function(section){
      var box = document.createElement('div');
      box.className = 'tech-spec-section';

      var h = document.createElement('h4');
      h.textContent = section[0];
      box.appendChild(h);

      var ul = document.createElement('ul');
      (section[1] || []).forEach(function(item){
        var li = document.createElement('li');
        li.textContent = item;
        ul.appendChild(li);
      });
      box.appendChild(ul);
      sectionsWrap.appendChild(box);
    });

    modal.classList.add('open');
    modal.setAttribute('aria-hidden','false');
    document.body.style.overflow = 'hidden';
  }

  function closeTechModal(){
    if(!modal) return;
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden','true');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.technical-spec-btn').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault();
      var key = btn.getAttribute('data-tech-key');
      openTechModal(key);
    });
  });

  document.querySelectorAll('[data-close-tech-modal]').forEach(function(el){
    el.addEventListener('click', function(e){
      e.preventDefault();
      closeTechModal();
    });
  });

  document.querySelectorAll('.tech-spec-contact-btn').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault();
      closeTechModal();
      openContactSection();
    });
  });

  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape') closeTechModal();
  });
});
</script>


