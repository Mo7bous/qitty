<script id="qitty-v101-contact-email-target-script">
document.addEventListener('DOMContentLoaded', function(){
  const QITTY_CONTACT_EMAIL = "bouhlal.achraf@gmail.com";

  function setContactTargets(){
    document.querySelectorAll('a[href^="mailto:"]').forEach(function(a){
      a.setAttribute('href', 'mailto:' + QITTY_CONTACT_EMAIL);
      if(!a.textContent.trim() || a.textContent.indexOf('@') !== -1){
        a.textContent = QITTY_CONTACT_EMAIL;
      }
    });

    document.querySelectorAll('form').forEach(function(form){
      form.setAttribute('data-contact-email', QITTY_CONTACT_EMAIL);

      let hidden = form.querySelector('input[name="to"], input[name="recipient"], input[name="email_to"], input[name="destinataire"]');
      if(!hidden){
        hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'to';
        form.appendChild(hidden);
      }
      hidden.value = QITTY_CONTACT_EMAIL;
    });
  }

  function buildMailBody(form){
    const data = new FormData(form);
    const lines = [];
    data.forEach(function(value, key){
      if(['to','recipient','email_to','destinataire'].includes(String(key).toLowerCase())) return;
      if(String(value || '').trim()) lines.push(key + ': ' + value);
    });
    return encodeURIComponent(lines.join('\n'));
  }

  // Safety: any contact/devis form submit opens an email to the fixed address
  document.addEventListener('submit', function(e){
    const form = e.target;
    if(!form || !(form instanceof HTMLFormElement)) return;

    const inContact = form.closest('[data-section="contact"]') || form.id === 'contactForm' || form.className.includes('contact');
    if(!inContact) return;

    const action = form.getAttribute('action') || '';
    const hasRealBackend = action && !action.startsWith('#') && !action.startsWith('mailto:');

    setContactTargets();

    if(!hasRealBackend){
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();

      const subject = encodeURIComponent('Demande de contact / devis Qitty');
      const body = buildMailBody(form);
      window.location.href = 'mailto:' + QITTY_CONTACT_EMAIL + '?subject=' + subject + '&body=' + body;
      return false;
    }
  }, true);

  // Safety for quote/contact CTA buttons that should lead to contact section, not other emails
  document.addEventListener('click', function(e){
    const btn = e.target.closest('a[href^="mailto:"], button[data-target="contact"], a[data-target="contact"], a[href="#contact"]');
    if(!btn) return;
    if(btn.matches('a[href^="mailto:"]')){
      btn.setAttribute('href', 'mailto:' + QITTY_CONTACT_EMAIL);
    }
  }, true);

  setContactTargets();
});
</script>


