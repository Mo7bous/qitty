<script id="solutions-auto-carousel-final-script">
document.addEventListener('DOMContentLoaded', function(){
  function initQittyCarousels(){
    document.querySelectorAll('[data-section="solutions"] .qitty-auto-carousel').forEach(function(carousel){
      if(carousel.dataset.qittyCarouselReady === '1') return;
      carousel.dataset.qittyCarouselReady = '1';

      const slides = Array.from(carousel.querySelectorAll('.qitty-carousel-slide'));
      const dots = Array.from(carousel.querySelectorAll('.qitty-carousel-dot'));
      if(slides.length <= 1) return;

      let index = Math.max(0, slides.findIndex(s => s.classList.contains('active')));
      const delay = parseInt(carousel.dataset.carouselDelay || '3000', 10);

      function showSlide(nextIndex){
        slides.forEach((slide, i) => slide.classList.toggle('active', i === nextIndex));
        dots.forEach((dot, i) => dot.classList.toggle('active', i === nextIndex));
        index = nextIndex;
      }

      showSlide(index);
      setInterval(function(){
        showSlide((index + 1) % slides.length);
      }, delay);
    });
  }

  initQittyCarousels();
  setTimeout(initQittyCarousels, 500);
});
</script>


