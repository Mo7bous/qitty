<script id="qitty-v81-articles-and-skills-test-script">
document.addEventListener('DOMContentLoaded', function(){
  /* Anti-doublon articles par titre + href */
  var seenArticles = new Set();
  document.querySelectorAll('[data-section="articles"] .article-card').forEach(function(card){
    var title = (card.querySelector('h3') || {}).textContent || '';
    var href = (card.querySelector('a[href]') || {}).href || '';
    var key = title.trim().toLowerCase() + '|' + href.trim().toLowerCase();
    if(seenArticles.has(key)){
      card.remove();
    }else{
      seenArticles.add(key);
    }
  });

  var modal = document.getElementById('qittySkillsTestModal');
  if(!modal) return;

  var openButtons = document.querySelectorAll('.qitty-skills-test-open');
  var closeButtons = modal.querySelectorAll('[data-skills-close]');
  var steps = Array.prototype.slice.call(modal.querySelectorAll('.qitty-skills-step'));
  var progress = document.getElementById('qittySkillsProgressBar');
  var summary = document.getElementById('qittySkillsSummary');
  var capability = document.getElementById('qittySkillsCapabilityText');
  var answers = {};
  var current = 0;

  var labels = [
    'Type de projet',
    'Données',
    'Interactivité',
    'Fonctionnalités',
    'Approche souhaitée',
    'Complexité'
  ];

  function openModal(){
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden','false');
    document.body.classList.add('qitty-skills-modal-open');
    goTo(0);
  }

  function closeModal(){
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden','true');
    document.body.classList.remove('qitty-skills-modal-open');
  }

  function goTo(index){
    current = index;
    steps.forEach(function(step, i){
      step.classList.toggle('active', i === index);
    });
    if(progress){
      progress.style.width = Math.round((index / (steps.length - 1)) * 100) + '%';
    }
    if(index === steps.length - 1){
      renderSummary();
    }
  }

  function getCapabilityText(){
    var all = Object.values(answers).flat().join(' | ').toLowerCase();
    var parts = [];

    if(all.includes('statique')){
      parts.push('un site statique propre, rapide, responsive et optimisé pour présenter une activité ou une offre');
    }
    if(all.includes('dynamique') || all.includes('comptes') || all.includes('rôles') || all.includes('workflow')){
      parts.push('une plateforme dynamique avec formulaires, recherche, statuts, rôles, historiques et espace privé');
    }
    if(all.includes('crm') || all.includes('erp') || all.includes('clients') || all.includes('dossiers') || all.includes('conformité')){
      parts.push('un CRM/ERP métier avec gestion de dossiers, documents, clients, conformité, audits et reporting');
    }
    if(all.includes('base') || all.includes('données') || all.includes('historique')){
      parts.push('une base de données adaptée au volume : petite base simple, base relationnelle ou structure plus complète avec historique');
    }
    if(all.includes('dashboard') || all.includes('kpi') || all.includes('reporting')){
      parts.push('des dashboards KPI pour piloter les résultats, suivre les volumes et visualiser les priorités');
    }
    if(all.includes('paiements') || all.includes('facturation')){
      parts.push('une logique de paiement, facturation ou suivi transactionnel selon le besoin');
    }
    if(all.includes('gps') || all.includes('carte')){
      parts.push('des fonctions GPS, carte interactive, points d’intérêt, signalements ou gestion terrain');
    }
    if(all.includes('ia') || all.includes('assistant')){
      parts.push('des assistants IA, générateurs de contenu, prompts structurés ou workflows intelligents');
    }
    if(all.includes('automatisation') || all.includes('emails') || all.includes('tâches')){
      parts.push('des automatisations pour réduire les tâches répétitives, emails, exports, validations et traitements manuels');
    }

    if(parts.length === 0){
      parts.push('un diagnostic pour clarifier le besoin, choisir une architecture simple et construire un premier prototype testable');
    }

    return 'Sur base de vos réponses, Qitty peut proposer ' + parts.join(', ') + '. L’approche peut être générique si vous voulez aller vite, ou tailor-made si votre processus est spécifique. Le projet peut démarrer par un prototype, puis évoluer vers une solution plus complète.';
  }

  function renderSummary(){
    if(!summary || !capability) return;
    var html = '';
    for(var i = 0; i < labels.length; i++){
      var value = answers[i];
      if(!value) value = 'Non précisé';
      if(Array.isArray(value)) value = value.join(', ');
      html += '<div><strong>' + labels[i] + '</strong>' + value + '</div>';
    }
    summary.innerHTML = html;
    capability.textContent = getCapabilityText();
  }

  openButtons.forEach(function(btn){
    btn.addEventListener('click', openModal);
  });

  closeButtons.forEach(function(btn){
    btn.addEventListener('click', function(){
      closeModal();
      if(btn.matches('[data-target="contact"]')){
        document.querySelectorAll('.page-section').forEach(function(section){
          section.classList.toggle('active', section.dataset.section === 'contact');
        });
      }
    });
  });

  modal.addEventListener('click', function(e){
    if(e.target.matches('[data-skills-close]')) closeModal();
  });

  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
  });

  steps.forEach(function(step){
    var index = Number(step.dataset.step);
    var multi = !!step.querySelector('.qitty-skills-options.multi');
    step.querySelectorAll('.qitty-skills-options button').forEach(function(btn){
      btn.addEventListener('click', function(){
        if(multi){
          btn.classList.toggle('selected');
          answers[index] = Array.prototype.slice.call(step.querySelectorAll('.qitty-skills-options button.selected')).map(function(b){ return b.dataset.value; });
        }else{
          answers[index] = btn.dataset.value;
          step.querySelectorAll('.qitty-skills-options button').forEach(function(b){ b.classList.remove('selected'); });
          btn.classList.add('selected');
          setTimeout(function(){ goTo(Math.min(index + 1, steps.length - 1)); }, 180);
        }
      });
    });
  });

  modal.querySelectorAll('.qitty-skills-next').forEach(function(btn){
    btn.addEventListener('click', function(){
      goTo(Math.min(current + 1, steps.length - 1));
    });
  });

  modal.querySelectorAll('.qitty-skills-restart').forEach(function(btn){
    btn.addEventListener('click', function(){
      answers = {};
      modal.querySelectorAll('.qitty-skills-options button').forEach(function(b){ b.classList.remove('selected'); });
      goTo(0);
    });
  });
});
</script>


<script id="qitty-v82-skills-test-multi-prefill-script">
document.addEventListener('DOMContentLoaded', function(){
  var modal = document.getElementById('qittySkillsTestModal');
  if(!modal) return;

  var steps = Array.prototype.slice.call(modal.querySelectorAll('.qitty-skills-step'));
  var progress = document.getElementById('qittySkillsProgressBar');
  var summary = document.getElementById('qittySkillsSummary');
  var capability = document.getElementById('qittySkillsCapabilityText');
  var restartButtons = modal.querySelectorAll('.qitty-skills-restart');
  var quoteButtons = modal.querySelectorAll('.qitty-skills-quote-request');
  var answers = {};
  var current = 0;

  var labels = [
    'Type de projet',
    'Données',
    'Interactivité',
    'Fonctionnalités importantes',
    'Approche souhaitée',
    'Complexité attendue'
  ];

  function goTo(index){
    current = index;
    steps.forEach(function(step, i){
      step.classList.toggle('active', i === index);
    });
    if(progress){
      progress.style.width = Math.round((index / (steps.length - 1)) * 100) + '%';
    }
    if(index === steps.length - 1){
      renderProposalOnly();
    }
  }

  function selectedValues(stepIndex){
    var step = modal.querySelector('.qitty-skills-step[data-step="' + stepIndex + '"]');
    if(!step) return [];
    return Array.prototype.slice.call(step.querySelectorAll('.qitty-skills-options button.selected')).map(function(btn){
      return btn.dataset.value || btn.textContent.trim();
    });
  }

  function refreshAnswers(){
    for(var i = 0; i < 6; i++){
      answers[i] = selectedValues(i);
    }
  }

  function getAllText(){
    refreshAnswers();
    return Object.values(answers).flat().join(' | ').toLowerCase();
  }


  function buildProposal(){
    var all = getAllText();

    var projectType = (answers[0] && answers[0].length) ? answers[0].join(', ') : '';
    var dataNeed = (answers[1] && answers[1].length) ? answers[1].join(', ') : '';
    var interaction = (answers[2] && answers[2].length) ? answers[2].join(', ') : '';
    var features = (answers[3] && answers[3].length) ? answers[3].join(', ') : '';
    var approach = (answers[4] && answers[4].length) ? answers[4].join(', ') : '';
    var complexity = (answers[5] && answers[5].length) ? answers[5].join(', ') : '';

    var isStatic = all.includes('statique') || all.includes('site vitrine');
    var isDynamic = all.includes('dynamique') || all.includes('comptes') || all.includes('rôles') || all.includes('workflow');
    var isBusinessTool = all.includes('crm') || all.includes('erp') || all.includes('outil interne') || all.includes('clients') || all.includes('dossiers');
    var hasAutomation = all.includes('automatisation') || all.includes('emails') || all.includes('tâches');
    var hasData = all.includes('base') || all.includes('données') || all.includes('historique');
    var hasDashboard = all.includes('dashboard') || all.includes('kpi') || all.includes('reporting');
    var hasPayments = all.includes('paiements') || all.includes('facturation');
    var hasMap = all.includes('gps') || all.includes('carte');
    var hasAI = all.includes('ia') || all.includes('assistant') || all.includes('génération');
    var hasCompliance = all.includes('conformité') || all.includes('audit') || all.includes('certification');

    var opening = "Sur base de vos réponses, Qitty peut vous accompagner sur un projet personnalisé qui ne se limite pas à une simple page ou à un outil isolé. L’idée serait de cadrer votre besoin, de structurer les données utiles, puis de construire une solution claire, exploitable et évolutive.";

    if(isStatic && !isDynamic && !isBusinessTool){
      opening = "Sur base de vos réponses, Qitty peut vous proposer une solution digitale simple, propre et professionnelle, pensée pour présenter votre activité, clarifier votre offre et tester rapidement votre positionnement avant d’aller vers une solution plus complète.";
    }

    if(isDynamic || isBusinessTool){
      opening = "Sur base de vos réponses, Qitty peut concevoir une plateforme métier adaptée à votre fonctionnement réel : une interface claire pour vos utilisateurs, une logique de données structurée, des écrans utiles au quotidien et des workflows qui suivent vos étapes opérationnelles.";
    }

    var middleParts = [];

    if(hasData){
      middleParts.push("Nous pouvons vous aider à transformer vos informations dispersées en une base de données cohérente, avec des champs, statuts, historiques et relations utiles pour éviter les fichiers manuels difficiles à suivre.");
    }
    if(hasAutomation){
      middleParts.push("Les automatisations peuvent ensuite réduire les tâches répétitives : génération de documents, envois d’emails, mises à jour de statuts, contrôles, rappels ou traitements qui prennent aujourd’hui trop de temps.");
    }
    if(hasDashboard){
      middleParts.push("Pour le pilotage, nous pouvons intégrer des tableaux de bord et indicateurs afin de rendre les résultats visibles : volumes, priorités, alertes, suivi des actions, performance ou qualité des données.");
    }
    if(hasAI){
      middleParts.push("Si l’IA est pertinente, elle peut être utilisée comme assistant de rédaction, d’analyse, de classification ou de génération, tout en gardant une logique contrôlée et adaptée à votre métier.");
    }
    if(hasMap){
      middleParts.push("Les fonctions de carte ou GPS peuvent être intégrées pour visualiser des lieux, suivre des signalements, organiser des zones, gérer des points d’intérêt ou faciliter le travail terrain.");
    }
    if(hasPayments){
      middleParts.push("Si votre projet implique des paiements ou de la facturation, Qitty peut prévoir une logique transactionnelle propre : suivi client, devis, factures, statuts de paiement ou intégration avec des outils spécialisés.");
    }
    if(hasCompliance){
      middleParts.push("Pour les besoins de conformité, d’audit ou de certification, nous pouvons structurer les preuves, documents, validations, responsabilités et historiques afin de rendre le suivi plus fiable.");
    }

    if(middleParts.length === 0){
      middleParts.push("La première étape utile serait de clarifier les priorités, identifier ce qui doit être automatisé ou structuré, puis construire un prototype testable avant de l’étendre.");
    }

    var approachText = "La bonne approche serait progressive : commencer par un cadrage fonctionnel, créer une première version utilisable, puis améliorer l’outil à partir des retours réels.";
    if(approach.toLowerCase().includes('tailor') || approach.toLowerCase().includes('sur mesure')){
      approachText = "Comme votre besoin semble orienté sur du sur mesure, l’approche recommandée serait de partir de vos processus existants plutôt que d’imposer un modèle générique.";
    }else if(approach.toLowerCase().includes('générique') || approach.toLowerCase().includes('rapide')){
      approachText = "Si l’objectif est d’aller vite, Qitty peut aussi partir d’une base générique et l’adapter progressivement à vos priorités.";
    }

    var closing = "Concrètement, Qitty peut être utile pour traduire votre idée en structure fonctionnelle, choisir les bons modules, construire l’interface, préparer la base de données, automatiser les étapes répétitives et vous fournir une solution compréhensible, maintenable et réellement utilisable.";

    return opening + " " + middleParts.join(" ") + " " + approachText + " " + closing;
  }


  function renderProposalOnly(){
    refreshAnswers();

    if(summary){
      var hidden = '';
      labels.forEach(function(label, i){
        var vals = answers[i] && answers[i].length ? answers[i].join(', ') : 'Non précisé';
        hidden += '<div><strong>' + label + '</strong>' + vals + '</div>';
      });
      summary.innerHTML = hidden;
    }

    if(capability){
      capability.textContent = buildProposal();
    }
  }

  function buildContactMessage(){
    refreshAnswers();

    var lines = [];
    lines.push('Bonjour,');
    lines.push('');
    lines.push('Je suis intéressé par un projet personnalisé.');
    lines.push('');
    lines.push('Sur base du diagnostic, voici ma demande :');
    labels.forEach(function(label, i){
      var vals = answers[i] && answers[i].length ? answers[i].join(', ') : 'Non précisé';
      lines.push('- ' + label + ' : ' + vals);
    });
    lines.push('');
    lines.push('Suggestion Qitty :');
    lines.push(buildProposal());
    lines.push('');
    lines.push('Pouvez-vous me recontacter pour discuter du cadrage, des possibilités techniques, du budget et des prochaines étapes ?');

    return lines.join('\n');
  }

  function prefillContactForm(){
    var message = buildContactMessage();

    // Fermer le modal
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden','true');
    document.body.classList.remove('qitty-skills-modal-open');

    // Aller à la section contact
    document.querySelectorAll('.page-section').forEach(function(section){
      section.classList.toggle('active', section.dataset.section === 'contact');
    });

    // Préremplir les champs du formulaire
    var contactSection = document.querySelector('[data-section="contact"]') || document;
    var subjectInput = contactSection.querySelector('input[placeholder*="Automatisation"], input[placeholder*="projet"], input:not([type]), input[type="text"]');
    var textarea = contactSection.querySelector('textarea');

    if(subjectInput){
      subjectInput.value = 'Projet personnalisé Qitty';
      subjectInput.dispatchEvent(new Event('input', { bubbles:true }));
    }

    if(textarea){
      textarea.value = message;
      textarea.dispatchEvent(new Event('input', { bubbles:true }));
      setTimeout(function(){ textarea.focus(); }, 250);
    }

    window.scrollTo({ top:0, behavior:'smooth' });
  }

  // Neutraliser le comportement auto-next du script précédent en capturant les clics au niveau modal
  modal.addEventListener('click', function(e){
    var option = e.target.closest('.qitty-skills-options button');
    if(option){
      e.stopImmediatePropagation();
      e.preventDefault();
      option.classList.toggle('selected');
      refreshAnswers();
      return false;
    }

    var next = e.target.closest('.qitty-skills-next');
    if(next){
      e.stopImmediatePropagation();
      e.preventDefault();
      refreshAnswers();
      goTo(Math.min(current + 1, steps.length - 1));
      return false;
    }

    var restart = e.target.closest('.qitty-skills-restart');
    if(restart){
      e.stopImmediatePropagation();
      e.preventDefault();
      answers = {};
      modal.querySelectorAll('.qitty-skills-options button').forEach(function(btn){ btn.classList.remove('selected'); });
      goTo(0);
      return false;
    }

    var quote = e.target.closest('.qitty-skills-quote-request');
    if(quote){
      e.stopImmediatePropagation();
      e.preventDefault();
      prefillContactForm();
      return false;
    }
  }, true);

  // S'assurer que tous les steps non finaux ont un bouton Continuer
  steps.forEach(function(step){
    if(step.dataset.step !== '6' && !step.querySelector('.qitty-skills-next')){
      var btn = document.createElement('button');
      btn.className = 'qitty-skills-next';
      btn.type = 'button';
      btn.textContent = 'Continuer →';
      step.appendChild(btn);
    }
  });
});
</script>


<script id="qitty-v87-about-kpi-carousel-script">
