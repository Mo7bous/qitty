  function answer(title, paragraphs, options){
    options = options || {};
    const active = activeSectionKey();
    const contextNote = options.context === false ? '' :
      '<div class="qitty-context-note">Contexte actuel : vous êtes dans la section <strong>'+sectionLabel(active)+'</strong>. '+((KNOWLEDGE.sections[active]||{}).next || '')+'</div>';
